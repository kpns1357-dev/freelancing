rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Top-level user document (profile settings, dark mode)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // All private subcollections under this user (clients, projects, invoices, activities)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
