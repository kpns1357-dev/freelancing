rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Top-level user document (profile, global preferences, dark mode)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Clients subcollection
      match /clients/{clientId} {
        allow read, write: if isOwner(userId);
      }

      // Projects subcollection
      match /projects/{projectId} {
        allow read, write: if isOwner(userId);
      }

      // Invoices subcollection
      match /invoices/{invoiceId} {
        allow read, write: if isOwner(userId);
      }

      // Activity Feed subcollection
      match /activities/{activityId} {
        allow read, write: if isOwner(userId);
      }

      // Any additional subcollection for future extensions
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny access to any other collections by default
    match /{document=**} {
      allow read, write: false;
    }
  }
}
